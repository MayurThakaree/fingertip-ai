# Copy this file to .env.local (gitignored) — needed in BOTH the project
# root (next to package.json) AND src-tauri/ (Cargo's working directory
# during `cargo run` differs from the project root) — see README
# troubleshooting section if AI requests say "missing or empty API key"
# despite this being filled in.
#
# Read Rust-side only, never referenced from src/ (frontend) directly, so
# it can't be extracted via dev tools.

AI_PROVIDER=gemini

# --- Single key (simplest) ---
AI_API_KEY=your-gemini-api-key-here

# --- Multiple keys (recommended) ---
# Comma-separated. When one key hits its daily rate limit (HTTP 429), the
# app automatically rotates to the next one instead of failing — see
# src-tauri/src/ai/key_pool.rs. If AI_API_KEYS is set, it's used instead
# of the single AI_API_KEY above.
#
# IMPORTANT: Google enforces quota per PROJECT, not per key. Multiple keys
# from the SAME Google Cloud project all share one quota pool and will run
# out together — rotation won't help. To actually get more free daily
# capacity, create each key in its own separate project (you can do this
# from a single Google account — no need for multiple accounts):
#   1. Go to https://aistudio.google.com/apikey
#   2. Click "Create API key" -> "Create API key in new project"
#   3. Repeat 3-4 times, each time choosing "new project"
#
# AI_API_KEYS=key-from-project-1,key-from-project-2,key-from-project-3,key-from-project-4

# Optional overrides:
# AI_MODEL=gemini-3.6-flash
# AI_TEMPERATURE=0.7
